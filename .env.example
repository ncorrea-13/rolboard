CLIENT_PORT=8080

# Required for admin routes (create campaign, list vault dirs) — see docs/API.md
ADMIN_TOKEN=change-me

DB_PATH=/data/campaign.db

VAULTS_ROOT_HOST=/path/to/vaults/parent

# Hostname (or hostname:port) of the backend service.
# Use the service/container name for Compose/network-based setups (default),
# or "localhost" if client and server share a network namespace (e.g. Podman Pod).
#BACKEND_HOST=rolboard-server

# Session cookie sends Secure by default (requires HTTPS). Set to "false" only
# for local dev over plain HTTP — never in a public deployment.
# COOKIE_SECURE=false

# --- Production only (see "Production deployment" in README.md) ---
# DATA_PATH=./data
# ADMIN_TOKEN_FILE_HOST=./secrets/admin_token   # only if using a Docker (no Swarm) `file:` secret — Podman uses `podman secret create` instead
