CLIENT_PORT=8080
VAULTS_ROOT_HOST=/path/to/vaults

# Container user (uid:gid). Default 1000:1000. Rootless Podman: set 0 so the server can
# read a vault you own (root inside a rootless container is your own user). Never 0 on rootful Docker.
# ROLBOARD_USER=0

# Production (compose.yaml in README): host folder for campaign.db and uploads
DATA_PATH=./data

# Development only (docker-compose.yml). Production uses the rolboard_admin_token secret.
ADMIN_TOKEN=change-me

# Session cookies are Secure by default (HTTPS). Set false only for local HTTP.
COOKIE_SECURE=false

# JSON structured logs (log/slog). Default: human-readable text.
LOG_JSON=true

# Trust CF-Connecting-IP for rate limiting. Only enable if every request is
# guaranteed to pass through Cloudflare (no port exposed elsewhere) — the
# header is otherwise attacker-controlled and defeats the rate limit.
TRUST_PROXY_HEADERS=true
